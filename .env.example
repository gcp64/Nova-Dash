# Nova-Dash Environment Variables

# The API Key for your provider (DeepSeek, OpenAI, Groq, local LM Studio, etc)
API_KEY=your_api_key_here

# Base URL of your AI provider. Ensure it points to the /v1 endpoints.
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# Local LM Studio: http://localhost:1234/v1
BASE_URL=https://api.deepseek.com/v1

# The name of the model you want to use
# Examples: deepseek-chat, gpt-4o, gpt-3.5-turbo, etc.
MODEL_NAME=deepseek-chat

# The port for the backend server to run on (default 3001)
PORT=3001
